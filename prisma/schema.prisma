// ============================================================
// SaaS Multi-Tenant E-commerce Platform - Prisma Schema
// Estrategia: Shared Schema + Row-Level Tenancy (tenantId)
// Escala objetivo: 2000+ tiendas en la misma base de datos
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// TENANT (cada tienda es un tenant)
// ------------------------------------------------------------
model Tenant {
  id          String       @id @default(uuid())
  slug        String       @unique // usado para subdominio: {slug}.plataforma.com
  name        String
  customDomain String?     @unique // dominio propio opcional (tienda.com)
  plan        TenantPlan   @default(FREE)
  status      TenantStatus @default(ACTIVE)
  logoUrl     String?
  primaryColor String?     @default("#6366F1")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relaciones (todas con tenantId para aislar datos por tienda)
  users       User[]
  products    Product[]
  categories  Category[]
  orders      Order[]
  customers   Customer[]
  settings    TenantSettings?

  @@index([slug])
  @@index([status])
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL_EXPIRED
  CANCELLED
}

model TenantSettings {
  id           String  @id @default(uuid())
  tenantId     String  @unique
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency     String  @default("BOB")
  taxRate      Float   @default(0)
  whatsappNumber String?
  paymentMethods Json  @default("[]") // ["qr", "card", "cash_on_delivery"]
  shippingZones  Json  @default("[]")
}

// ------------------------------------------------------------
// USERS (dueños/admins de tienda + super-admins de plataforma)
// ------------------------------------------------------------
model User {
  id        String   @id @default(uuid())
  tenantId  String?  // null = super-admin de la plataforma
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String
  password  String
  name      String
  role      UserRole @default(STORE_ADMIN)
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum UserRole {
  SUPER_ADMIN   // administra la plataforma completa
  STORE_ADMIN   // dueño de una tienda
  STORE_STAFF   // empleado con permisos limitados
}

// ------------------------------------------------------------
// CATALOGO
// ------------------------------------------------------------
model Category {
  id       String    @id @default(uuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  name        String
  slug        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  images      Json     @default("[]") // ["url1", "url2"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ------------------------------------------------------------
// CLIENTES DE CADA TIENDA (compradores finales)
// ------------------------------------------------------------
model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())

  orders    Order[]

  @@index([tenantId])
}

// ------------------------------------------------------------
// PEDIDOS
// ------------------------------------------------------------
model Order {
  id          String      @id @default(uuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  status      OrderStatus @default(PENDING)
  total       Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2) // precio al momento de compra
}
